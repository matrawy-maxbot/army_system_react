{
  "name": "army-system-electron",
  "version": "1.0.0",
  "description": "نظام إدارة المستندات العسكرية - Army Document Management System",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "keywords": [
    "electron",
    "react",
    "army",
    "documents",
    "management"
  ],
  "author": "Army System",
  "license": "ISC",
  "dependencies": {
    "electron": "22.3.27",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "3.1.0",
    "concurrently": "^8.2.0",
    "electron-builder": "23.6.0",
    "vite": "4.3.9",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.army.system",
    "productName": "Army System",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "public/icons/icon.ico"
    }
  }
}
