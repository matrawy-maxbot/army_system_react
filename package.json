{
  "name": "army-system-electron",
  "version": "1.0.0",
  "type": "module",
  "description": "نظام إدارة المستندات العسكرية - Army Document Management System",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "electron-builder",
    "dist": "npm run build && npm run electron:build",
    "clean": "rmdir /s /q dist-vite build 2>nul || true",
    "test:db": "node test-database.js"
  },
  "keywords": [
    "electron",
    "react",
    "army",
    "documents",
    "management"
  ],
  "author": "Army System",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "localforage": "^1.10.0",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "3.1.0",
    "concurrently": "^8.2.0",
    "electron": "22.3.27",
    "electron-builder": "23.6.0",
    "vite": "4.3.9",
    "wait-on": "^7.0.1"
  }
}
